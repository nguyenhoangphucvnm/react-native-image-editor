{
  "name": "@phucprime/react-native-image-editor",
  "version": "1.0.3",
  "description": "React Native: Native Image Editor for iOS and Android with drawing, text, stickers, cropping and more",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "*.podspec"
  ],
  "homepage": "https://github.com/nguyenhoangphucvnm/react-native-image-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenhoangphucvnm/react-native-image-editor.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenhoangphucvnm/react-native-image-editor/issues"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src/",
    "format": "prettier --write src/",
    "clean": "rm -rf lib/",
    "prepare": "npm run clean && npm run build",
    "release": "npm run prepare && npm publish --access public --registry https://registry.npmjs.org/",
    "release:github": "dotenv -- npm publish"
  },
  "keywords": [
    "react-native",
    "image-editor",
    "photo-editor",
    "image",
    "photo",
    "editor",
    "crop",
    "draw",
    "sticker",
    "text",
    "ios",
    "android"
  ],
  "author": "phucprime",
  "license": "Apache-2.0",
  "codegenConfig": {
    "name": "RNPhotoEditorSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ui.photoeditor"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "18.2.0 || 19.0.0",
    "dotenv-cli": "11.0.0",
    "prettier": "3.2.0",
    "react-native": "0.78.2",
    "react-native-builder-bob": "0.43.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}